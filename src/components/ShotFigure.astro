---
/**
 * ShotFigure.astro — a scripted capture of a live surface, embedded with
 * the house light/dark swap (the same html.dark mechanism as the shell's
 * logos; a prefers-color-scheme media query would ignore the manual
 * theme toggle). The capture date + source URL ride the caption: every
 * screenshot on the technology pages is regenerated by
 * scripts/capture-technologies.ts (TODO.promotion/10), never hand-snapped.
 */
interface Props {
  /** The page folder under /img/technologies/ (e.g. "cnml"). */
  page: string
  /** The capture stem (e.g. "verify" → verify-light.png + verify-dark.png). */
  stem: string
  /** One sentence stating what the capture shows (the style guide's rule). */
  alt: string
  /** The captured surface's live URL, linked from the caption. */
  source: string
  /** The capture date (the freshness discipline), e.g. "2026-08-29". */
  captured: string
  /** Set false when the surface has no dark variant (a single -light file). */
  dark?: boolean
}
const { page, stem, alt, source, captured, dark = true } = Astro.props
const base = `/img/technologies/${page}/${stem}`
---

<figure class="shot-figure">
  <a href={source} class="shot-link" target="_blank" rel="noopener noreferrer">
    <img src={`${base}-light.png`} alt={alt} loading="lazy" class:list={['shot-img', { 'shot-light': dark }]} />
    {dark && <img src={`${base}-dark.png`} alt="" aria-hidden="true" loading="lazy" class="shot-img shot-dark" />}
  </a>
  <figcaption class="shot-caption">
    {alt} <a href={source} class="shot-source">Live surface</a> · captured {captured} by the scripted apparatus.
  </figcaption>
</figure>

<style>
  .shot-figure {
    margin: 2rem 0;
    border: 1px solid var(--rule);
    border-radius: var(--bp-radius-md, 6px);
    overflow: hidden;
    background: var(--paper);
  }
  .shot-link {
    display: block;
    text-decoration: none;
  }
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  .shot-dark { display: none; }
  :global(.dark) .shot-light { display: none; }
  :global(.dark) .shot-dark { display: block; }
  .shot-caption {
    padding: 0.625rem 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .shot-source {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
