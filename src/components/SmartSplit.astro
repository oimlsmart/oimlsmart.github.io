---
/**
 * SmartSplit.astro — the SMART / SMART+ split, first-class on every
 * technology page (TODO.promotion/10 block 4). Two visually separated
 * panels: Today (SMART) lists only what is live and linkable; The vision
 * (SMART+) lists the twin, the simulation, the signed measurements, and
 * continuous compliance, each item carrying the word "roadmap" and its
 * anchor. Nothing future is ever stated as present.
 */
interface Item {
  /** One honest sentence. */
  text: string
  /** The live link (today) or the roadmap anchor (vision). */
  href?: string
  /** Link label (defaults to "open" for today, "roadmap" for vision). */
  label?: string
}
interface Props {
  today: Item[]
  vision: Item[]
}
const { today, vision } = Astro.props
---

<div class="smart-split">
  <div class="split-panel split-today">
    <p class="split-label">Today · SMART</p>
    <ul>
      {today.map((item) => (
        <li>
          {item.text}
          {item.href && (
            <a href={item.href} class="split-link"> {item.label ?? 'open'} ↗</a>
          )}
        </li>
      ))}
    </ul>
  </div>
  <div class="split-panel split-vision">
    <p class="split-label">The vision · SMART+</p>
    <ul>
      {vision.map((item) => (
        <li>
          {item.text}
          {item.href && (
            <a href={item.href} class="split-link"> {item.label ?? 'roadmap'} ↗</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .smart-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  @media (max-width: 720px) {
    .smart-split { grid-template-columns: 1fr; }
  }
  .split-panel {
    border: 1px solid var(--rule);
    border-radius: var(--bp-radius-md, 6px);
    padding: 1rem 1.25rem;
    background: var(--paper);
  }
  .split-today {
    border-left: 3px solid var(--accent);
  }
  .split-vision {
    border: 1px dashed var(--rule);
    border-left: 3px dashed var(--accent-3);
  }
  .split-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.625rem;
  }
  .split-panel ul {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .split-panel li {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
    color: var(--ink-soft);
  }
  .split-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
</style>
