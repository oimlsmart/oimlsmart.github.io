---
/** Wrapper — the component lives in @oimlsmart/site-shell (one chrome
 *  SSOT, TODO.FULL/02); this file forwards props + slots. The hero
 *  mark's logo base is injected here (the package ships no asset origin
 *  since 0.2.0): www's canonical copy at
 *  https://www.oimlsmart.org/img/components/, unless a caller overrides
 *  it for staging. */
import Pkg from '@oimlsmart/site-shell/chrome/astro/PageHero.astro'
import { COMPONENT_ASSET_BASE } from '../data/site-meta'

const props = Astro.props
const logo = props.logo ? { ...props.logo, base: props.logo.base ?? COMPONENT_ASSET_BASE } : props.logo
---

<Pkg {...props} logo={logo}><slot /></Pkg>
