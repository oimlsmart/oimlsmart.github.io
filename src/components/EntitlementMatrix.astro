---
/**
 * EntitlementMatrix.astro — the renderer for the ONE entitlement
 * source (src/data/entitlement-matrix.ts, TODO.promotion/09). The
 * "who can run what" page renders the full matrix; later audience /
 * services / technologies pages quote their rows from the same data —
 * never a hand-copied table.
 */
import {
  ENTITLEMENT_MATRIX,
  ENTITLEMENT_LEGEND,
  MEMBER_CATEGORIES,
  type EntitlementCell,
} from '../data/entitlement-matrix'

const GLYPHS: Record<string, string> = Object.fromEntries(
  ENTITLEMENT_LEGEND.map((l) => [l.mark, l.glyph]),
)
---

<div class="entitlement-matrix">
  <ul class="flex flex-wrap gap-x-6 gap-y-1 mb-6 text-sm text-ink-soft">
    {ENTITLEMENT_LEGEND.map((l) => (
      <li><span aria-hidden="true">{l.glyph}</span> {l.label}</li>
    ))}
    <li>
      <span class="proposed-badge">proposed</span> the coordinator’s
      extrapolation — not yet confirmed policy
    </li>
  </ul>

  <div class="overflow-x-auto border border-rule rounded-md">
    <table class="w-full border-collapse text-sm min-w-[64rem]">
      <thead>
        <tr class="bg-paper-soft">
          <th class="text-left font-medium p-3 border-b border-rule">Service</th>
          {MEMBER_CATEGORIES.map((c) => (
            <th class="text-left font-medium p-3 border-b border-l border-rule">{c.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {ENTITLEMENT_MATRIX.map((s) => (
          <tr class="align-top">
            <th class="text-left font-medium p-3 border-b border-rule bg-paper-soft">
              {s.href ? (
                <a href={s.href} class="text-accent">{s.name}</a>
              ) : (
                s.name
              )}
            </th>
            {MEMBER_CATEGORIES.map((c) => {
              const cell: EntitlementCell = s.cells[c.id]
              return (
                <td class="p-3 border-b border-l border-rule">
                  {cell.roadmap ? (
                    <span class="text-ink-muted font-mono text-xs">roadmap</span>
                  ) : (
                    <>
                      {cell.marks.length > 0 && (
                        <span class="whitespace-nowrap">
                          {cell.marks.map((m) => GLYPHS[m]).join(' ')}
                        </span>
                      )}
                      {cell.marks.length === 0 && !cell.note && (
                        <span class="text-ink-muted">—</span>
                      )}
                      {cell.note && (
                        <span class="text-ink-soft"> {cell.note}</span>
                      )}
                      {cell.proposed && (
                        <span class="proposed-badge">proposed</span>
                      )}
                    </>
                  )}
                </td>
              )
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .entitlement-matrix .proposed-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    padding: 0.25em 0.5em;
    border: 1px dashed var(--ink-muted);
    border-radius: 999px;
    color: var(--ink-muted);
    vertical-align: middle;
    margin-left: 0.25rem;
    white-space: nowrap;
  }
</style>
