---
/**
 * DeploymentPostures — the four deployment modes in one diagram: the
 * CS-operated hub every role signs into; the IA-only, TL-only, and
 * IA+TL member instances, one codebase booted per profile; what
 * federates where (signed evaluation chains to the hub; dispatched
 * work and reports between hub and laboratory). House style; dark-mode
 * correct via the TechFigure palette. (TODO.promotion/10: one diagram
 * per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="One codebase, four postures decided by the deployment profile: who signs in, what each runs, what federates where.">
  <svg viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="uc-postures-title">
    <title id="uc-postures-title">The four deployment postures: the CS-operated hub serving every role; the IA-only instance submitting signed evaluation chains; the TL-only instance receiving dispatched work; the IA+TL instance combining both; federation arrows between the member instances and the hub</title>

    <defs>
      <marker id="uc-parr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">The deployment-mode matrix, drawn plain</text>

    <!-- the hub -->
    <rect x="30" y="80" width="330" height="330" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="195" y="110" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gen-text)">CS-operated platform (the hub)</text>
    <text x="195" y="136" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">One deployment serves every role:</text>
    <text x="195" y="154" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">applicants, authorities, laboratories,</text>
    <text x="195" y="172" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the BIML register.</text>
    <text x="195" y="202" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Who signs in: everyone.</text>
    <text x="195" y="220" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">What it runs: the whole scheme</text>
    <text x="195" y="238" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">(application to register).</text>
    <text x="195" y="268" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Operated by: the scheme.</text>
    <text x="195" y="298" text-anchor="middle" font-size="11" font-style="italic" fill="var(--dg-text-muted)">the hosted OIML-CS SMART Platform;</text>
    <text x="195" y="316" text-anchor="middle" font-size="11" font-style="italic" fill="var(--dg-text-muted)">the demo is this posture</text>
    <text x="195" y="346" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Topology A of the deployment docs:</text>
    <text x="195" y="364" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">one store, one seed, every console.</text>

    <!-- IA-only -->
    <rect x="450" y="70" width="420" height="100" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="660" y="96" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">IA-only instance</text>
    <text x="660" y="116" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">The authority&#8217;s own: its officers, its applicants, its laboratories as accounts.</text>
    <text x="660" y="134" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Runs the intake, the evaluation projects, the certificates desk.</text>
    <text x="660" y="152" text-anchor="middle" font-size="11" font-style="italic" fill="var(--dg-text-muted)">Topology B: signed evaluation chains to the hub&#8217;s register.</text>

    <!-- TL-only -->
    <rect x="450" y="195" width="420" height="100" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="660" y="221" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">TL-only instance</text>
    <text x="660" y="241" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">The laboratory&#8217;s own: its operators; no applicant portal to run.</text>
    <text x="660" y="259" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Receives dispatched test work, returns the report as data.</text>
    <text x="660" y="277" text-anchor="middle" font-size="11" font-style="italic" fill="var(--dg-text-muted)">the pilot at tl.oimlsmart.org &#183; the start-small posture</text>

    <!-- IA+TL -->
    <rect x="450" y="320" width="420" height="100" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="660" y="346" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">IA+TL instance</text>
    <text x="660" y="366" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">An authority and its laboratory under one roof:</text>
    <text x="660" y="384" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the national metrology institute&#8217;s classical shape.</text>
    <text x="660" y="402" text-anchor="middle" font-size="11" font-style="italic" fill="var(--dg-text-muted)">the pilot at nmi.oimlsmart.org</text>

    <!-- federation arrows -->
    <line x1="450" y1="120" x2="368" y2="160" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#uc-parr)"/>
    <text x="404" y="128" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)" transform="rotate(-17 404 128)">signed chains</text>
    <line x1="368" y1="245" x2="442" y2="245" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#uc-parr)"/>
    <line x1="442" y1="262" x2="368" y2="262" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#uc-parr)"/>
    <text x="405" y="238" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)">dispatch</text>
    <text x="405" y="278" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)">reports</text>
    <line x1="450" y1="370" x2="368" y2="330" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#uc-parr)"/>
    <text x="404" y="342" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)" transform="rotate(17 404 342)">signed chains</text>

    <!-- the growth band -->
    <rect x="30" y="430" width="840" height="52" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="60" y="452" font-size="12" font-weight="600" fill="var(--dg-gov-text)">Start small, grow: a laboratory joins with the TL-only posture; the same codebase grows with it.</text>
    <text x="60" y="470" font-size="11" fill="var(--dg-text-soft)">The self-host entitlement attaches to the Member State; an authority or laboratory operates under its proposing Member State.</text>
  </svg>
</TechFigure>
