---
/**
 * SstRehearsal — training on the SST in one diagram: the laboratory
 * rehearses the full test program against the simulated instrument's
 * governed twin channel, the platform driving the simulation directly;
 * the operator's world channel and the bench hold the ground truth
 * behind the epistemic wall; the same workflow then runs the physical
 * instrument. House style; dark-mode correct via the TechFigure
 * palette. (TODO.promotion/10: one diagram per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="The rehearsal space where failing is free: the platform cannot tell the simulation from the served side, and the bench keeps the truth visible.">
  <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="uc-sst-title">
    <title id="uc-sst-title">Training on the SST: the platform drives the full certification workflow against the simulated instrument's twin channel; the operator's world channel (loads, chamber, faults, clock) and the bench sit behind the epistemic wall as the ground truth; the rehearsed workflow then runs unchanged against the physical instrument</title>

    <defs>
      <marker id="uc-sarr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">Rehearse first, hardware later</text>

    <!-- the platform side -->
    <rect x="30" y="80" width="250" height="120" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="155" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">The laboratory rehearses</text>
    <text x="155" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the full test program on the platform:</text>
    <text x="155" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">dispatch, guided runs, evidence,</text>
    <text x="155" y="158" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the test report, the verdicts</text>
    <text x="155" y="184" text-anchor="middle" font-size="10" font-style="italic" fill="var(--dg-text-muted)">the whole demo certifies the simulated LC-500</text>

    <!-- the SST -->
    <rect x="360" y="70" width="280" height="220" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="500" y="96" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gen-text)">The simulated instrument (SST)</text>

    <rect x="380" y="112" width="240" height="76" rx="8" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="500" y="134" text-anchor="middle" font-size="12" font-weight="600" fill="var(--dg-text)">/twin &#183; the governed channel</text>
    <text x="500" y="152" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the identical interface a physical SMART</text>
    <text x="500" y="168" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">instrument serves; the platform reads here</text>

    <line x1="500" y1="188" x2="500" y2="204" stroke="var(--dg-warn-stroke)" stroke-width="2" stroke-dasharray="3 3"/>
    <text x="500" y="200" text-anchor="middle" font-size="9" fill="var(--dg-warn-text)"></text>

    <rect x="380" y="208" width="240" height="66" rx="8" fill="var(--dg-warn-fill)" stroke="var(--dg-warn-stroke)" stroke-width="1.5"/>
    <text x="500" y="230" text-anchor="middle" font-size="12" font-weight="600" fill="var(--dg-warn-text)">/world &#183; the operator&#8217;s channel</text>
    <text x="500" y="248" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">place loads, sweep the chamber, inject</text>
    <text x="500" y="264" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">faults, advance the virtual clock</text>

    <!-- the epistemic wall label -->
    <text x="500" y="201" text-anchor="middle" font-size="9.5" fill="var(--dg-warn-text)">the epistemic wall</text>

    <line x1="280" y1="140" x2="372" y2="140" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#uc-sarr)"/>
    <text x="326" y="132" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)">drives directly</text>

    <!-- the bench -->
    <rect x="700" y="80" width="180" height="120" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5"/>
    <text x="790" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-source-text)">The bench</text>
    <text x="790" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the physical scene beside</text>
    <text x="790" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">an analogue dial: the truth</text>
    <text x="790" y="158" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">a trainee reads with their eyes</text>
    <text x="790" y="184" text-anchor="middle" font-size="10" font-style="italic" fill="var(--dg-text-muted)">the lying-twin lesson lives here</text>

    <line x1="640" y1="241" x2="762" y2="200" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#uc-sarr)"/>

    <!-- the graduation arrow -->
    <rect x="280" y="340" width="340" height="76" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="450" y="366" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-gov-text)">Then the physical instrument</text>
    <text x="450" y="386" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the same workflow, the same surfaces, the same</text>
    <text x="450" y="402" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">verdict chain: nothing new to learn on live work</text>

    <line x1="155" y1="200" x2="155" y2="378" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#uc-sarr)"/>
    <line x1="155" y1="378" x2="272" y2="378" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#uc-sarr)"/>

    <text x="450" y="456" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">Instruments that behave honestly, fail on purpose, and reset in seconds.</text>
  </svg>
</TechFigure>
