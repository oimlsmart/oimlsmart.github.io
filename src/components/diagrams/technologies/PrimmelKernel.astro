---
/**
 * PrimmelKernel — the Primmel mechanism in one diagram: three relations
 * (IS / HAS / DOES) over eight terms, packages composing with pinned
 * imports, and the public proof loop (lint rule catalog + the versioned
 * conformance suite) that any implementation can run. House style;
 * dark-mode correct via the TechFigure palette.
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="The kernel: three relations over eight terms. Around it: the package machinery and the public proof loop every implementation can run, not only the reference toolchain.">
  <svg viewBox="0 0 860 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="primmel-kernel-title">
    <title id="primmel-kernel-title">Primmel's kernel states identity, attribution, and behavior over eight terms; packages compose; the linter and the conformance suite prove a model runs</title>

    <defs>
      <marker id="prl-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"></path>
      </marker>
    </defs>

    <text x="430" y="30" text-anchor="middle" font-size="17" font-weight="600" fill="var(--dg-text)">The language a standard runs in</text>

    <!-- The three relations -->
    <rect x="30" y="56" width="250" height="88" rx="8" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" />
    <text x="155" y="82" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-source-text)">IS · what a thing is</text>
    <text x="155" y="100" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">identity: a load cell, a process,</text>
    <text x="155" y="114" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">a requirement</text>
    <text x="155" y="132" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">subjects · kinds · instantiation</text>

    <rect x="30" y="158" width="250" height="88" rx="8" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" />
    <text x="155" y="184" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-source-text)">HAS · what a thing has</text>
    <text x="155" y="202" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">attribution: the maximum capacity,</text>
    <text x="155" y="216" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">the accuracy class</text>
    <text x="155" y="234" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">properties · values · units</text>

    <rect x="30" y="260" width="250" height="88" rx="8" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" />
    <text x="155" y="286" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-source-text)">DOES · what a thing does</text>
    <text x="155" y="304" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">behavior: the creep test, the</text>
    <text x="155" y="318" text-anchor="middle" font-size="9.5" fill="var(--dg-text-soft)">evaluation, the issuance</text>
    <text x="155" y="336" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">processes · transitions</text>

    <!-- The constraint bind -->
    <rect x="330" y="120" width="200" height="160" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" />
    <text x="430" y="146" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--dg-gov-text)">A requirement is a bind</text>
    <text x="344" y="172" font-size="9.5" fill="var(--dg-text-soft)">constraint + the subject aspect</text>
    <text x="344" y="188" font-size="9.5" fill="var(--dg-text-soft)">it governs, with provenance:</text>
    <text x="344" y="212" font-size="9" font-family="ui-monospace, monospace" fill="var(--dg-text)">subject: load-cell</text>
    <text x="344" y="228" font-size="9" font-family="ui-monospace, monospace" fill="var(--dg-text)">aspect: Max (largest load)</text>
    <text x="344" y="244" font-size="9" font-family="ui-monospace, monospace" fill="var(--dg-text)">rule: rated ≤ applied ≤ Max</text>
    <text x="344" y="266" font-size="8.5" fill="var(--dg-text-muted)">typed, related, executable</text>

    <line x1="280" y1="100" x2="336" y2="150" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#prl-arr)" />
    <line x1="280" y1="202" x2="326" y2="202" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#prl-arr)" />
    <line x1="280" y1="304" x2="336" y2="254" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#prl-arr)" />

    <!-- The proof loop -->
    <rect x="580" y="56" width="250" height="130" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" />
    <text x="705" y="82" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--dg-gen-text)">The public proof loop</text>
    <text x="596" y="106" font-size="9.5" fill="var(--dg-text-soft)">the rule catalog (the linter's</text>
    <text x="596" y="122" font-size="9.5" fill="var(--dg-text-soft)">C-rules) checks every package</text>
    <text x="596" y="144" font-size="9.5" fill="var(--dg-text-soft)">the versioned conformance suite pairs</text>
    <text x="596" y="160" font-size="9.5" fill="var(--dg-text-soft)">a clause map with valid + invalid</text>
    <text x="596" y="176" font-size="9.5" fill="var(--dg-text-soft)">documents; any implementation runs it</text>

    <rect x="580" y="214" width="250" height="102" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" />
    <text x="705" y="240" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--dg-text)">Packages compose</text>
    <text x="596" y="264" font-size="9.5" fill="var(--dg-text-soft)">explicit imports, editions, and</text>
    <text x="596" y="280" font-size="9.5" fill="var(--dg-text-soft)">version pins; a Recommendation builds</text>
    <text x="596" y="296" font-size="9.5" fill="var(--dg-text-soft)">on the CASCO layers beneath it</text>

    <line x1="530" y1="170" x2="572" y2="130" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#prl-arr)" />
    <line x1="530" y1="230" x2="572" y2="258" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#prl-arr)" />

    <text x="430" y="386" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)">Validate · query · execute · reason: a model that cannot do all four is, in the language's own terms, a document in a costume.</text>
  </svg>
</TechFigure>
