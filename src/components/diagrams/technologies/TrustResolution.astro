---
/**
 * TrustResolution — the trust registry mechanism in one diagram: the
 * verifier resolves the signer's key and standing in one anonymous
 * request; the organization's own administrator registers, rotates, and
 * revokes; the time anchor answers "valid when signed" honestly after a
 * revocation. House style; dark-mode correct via the TechFigure palette.
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="Resolution is one anonymous, cacheable request: the verifier learns whose key this is and the organization's standing. After a revocation the time anchor still answers honestly: valid at the time, revoked since, on a stated date.">
  <svg viewBox="0 0 860 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="trust-resolution-title">
    <title id="trust-resolution-title">The verifier resolves the signer's organization, key set, and standing from the registry in one anonymous request; the organization's administrator manages the keys under audit</title>

    <defs>
      <marker id="trust-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"></path>
      </marker>
    </defs>

    <text x="430" y="30" text-anchor="middle" font-size="17" font-weight="600" fill="var(--dg-text)">Whose key is this, and in what standing</text>

    <!-- The verifier -->
    <rect x="30" y="120" width="190" height="120" rx="8" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" />
    <text x="125" y="148" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-text)">The verifier</text>
    <text x="46" y="172" font-size="9.5" fill="var(--dg-text-soft)">holds a signed artifact naming</text>
    <text x="46" y="188" font-size="9.5" fill="var(--dg-text-soft)">a key id + an organization id</text>
    <text x="46" y="212" font-size="9.5" fill="var(--dg-text-muted)">no account, no call-back,</text>
    <text x="46" y="228" font-size="9.5" fill="var(--dg-text-muted)">cache-bounded</text>

    <!-- The registry -->
    <rect x="310" y="86" width="260" height="188" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5" />
    <text x="440" y="112" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--dg-source-text)">The trust registry</text>
    <text x="440" y="130" text-anchor="middle" font-size="9" fill="var(--dg-text-muted)">on the identity service</text>
    <text x="326" y="156" font-size="9.5" font-family="ui-monospace, monospace" fill="var(--dg-text)">GET /op/keys/&lt;org&gt;.json</text>
    <text x="326" y="180" font-size="9.5" fill="var(--dg-text-soft)">answers: the organization, its kind,</text>
    <text x="326" y="196" font-size="9.5" fill="var(--dg-text-soft)">its state, its standing, its current</text>
    <text x="326" y="212" font-size="9.5" fill="var(--dg-text-soft)">public key set</text>
    <text x="326" y="238" font-size="9.5" fill="var(--dg-text-soft)">an unknown organization gets the</text>
    <text x="326" y="254" font-size="9.5" fill="var(--dg-text-soft)">honest refusal, not a guess</text>

    <!-- The org admin -->
    <rect x="640" y="66" width="190" height="110" rx="8" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" />
    <text x="735" y="92" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-text)">The organization's</text>
    <text x="735" y="108" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-text)">administrator</text>
    <text x="656" y="132" font-size="9.5" fill="var(--dg-text-soft)">registers, rotates, revokes the</text>
    <text x="656" y="148" font-size="9.5" fill="var(--dg-text-soft)">organization's own keys; every</text>
    <text x="656" y="164" font-size="9.5" fill="var(--dg-text-soft)">act on the audit chain</text>

    <!-- The verdict -->
    <rect x="640" y="226" width="190" height="120" rx="8" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" />
    <text x="735" y="252" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-gen-text)">The verdict</text>
    <text x="656" y="276" font-size="9.5" fill="var(--dg-text-soft)">signature sound + attributed to an</text>
    <text x="656" y="292" font-size="9.5" fill="var(--dg-text-soft)">accountable organization in good</text>
    <text x="656" y="308" font-size="9.5" fill="var(--dg-text-soft)">standing when it signed</text>
    <text x="735" y="332" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">the time anchor does the honest work</text>

    <line x1="220" y1="170" x2="302" y2="170" stroke="var(--dg-arrow)" stroke-width="1.6" marker-end="url(#trust-arr)" />
    <text x="261" y="160" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">resolve</text>
    <line x1="302" y1="200" x2="220" y2="200" stroke="var(--dg-arrow)" stroke-width="1.6" marker-end="url(#trust-arr)" />
    <text x="261" y="220" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">key set + standing</text>

    <line x1="692" y1="176" x2="570" y2="150" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#trust-arr)" />
    <text x="620" y="140" text-anchor="middle" font-size="8.5" fill="var(--dg-text-muted)">administers</text>

    <line x1="570" y1="240" x2="632" y2="270" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#trust-arr)" />

    <text x="430" y="386" text-anchor="middle" font-size="10" fill="var(--dg-text-muted)">The verifier never trusts a deployment; it resolves the signer against the registry.</text>
  </svg>
</TechFigure>
