---
/**
 * LaboratoryArc — the laboratory's arc in one diagram: the dispatch
 * lands in the inbox, the accept joins the Evaluation Project's
 * dataspace, the guided run captures evidence at the moment of work,
 * the report is generated — never transcribed. Records mode bridges the
 * offline world honestly; the twin rehearsal is the roadmap leg. House
 * style; dark-mode correct via the TechFigure palette.
 * (TODO.promotion/10: one diagram per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="Your metrologists' expertise goes into measurement; the paperwork mechanics leave the bench. The report an IA receives from you is data it can compute against, not prose it must trust.">
  <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="lab-arc-title">
    <title id="lab-arc-title">The laboratory's arc: the dispatch lands in the inbox, accept joins the Evaluation Project, the guided run accrues evidence, the report is generated, with records mode for offline work and the twin rehearsal as roadmap</title>

    <defs>
      <marker id="lab-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">The laboratory&#8217;s arc: evidence captured once, at the moment of work</text>

    <rect x="30" y="80" width="190" height="86" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="125" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">1 &#183; The dispatch lands</text>
    <text x="125" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the IA&#8217;s request in your inbox:</text>
    <text x="125" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">forms, samples, terms</text>

    <rect x="250" y="80" width="190" height="86" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="345" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">2 &#183; Accept</text>
    <text x="345" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">your laboratory joins the</text>
    <text x="345" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">Evaluation Project&#8217;s dataspace</text>

    <rect x="470" y="80" width="190" height="86" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="565" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-gen-text)">3 &#183; The guided run</text>
    <text x="565" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the workbench walks the procedure;</text>
    <text x="565" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">readings accrue as evidence</text>

    <rect x="690" y="80" width="180" height="86" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="780" y="106" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">4 &#183; The report</text>
    <text x="780" y="126" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">generated from the evidence,</text>
    <text x="780" y="142" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">never transcribed after</text>

    <line x1="220" y1="123" x2="242" y2="123" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#lab-arr)"/>
    <line x1="440" y1="123" x2="462" y2="123" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#lab-arr)"/>
    <line x1="660" y1="123" x2="682" y2="123" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#lab-arr)"/>

    <rect x="250" y="216" width="410" height="100" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="280" y="244" font-size="14" font-weight="600" fill="var(--dg-text)">Every row traces</text>
    <text x="280" y="266" font-size="12" fill="var(--dg-text-soft)">the condition, the input, the reading, the timestamp, the operator,</text>
    <text x="280" y="284" font-size="12" fill="var(--dg-text-soft)">and the clause that required it. Where evidence cannot be produced,</text>
    <text x="280" y="302" font-size="12" fill="var(--dg-text-soft)">the verdict reads INDETERMINATE, never a silent pass.</text>

    <rect x="30" y="216" width="190" height="100" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5"/>
    <text x="125" y="244" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-source-text)">Records mode</text>
    <text x="125" y="264" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">a report performed offline</text>
    <text x="125" y="280" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">registers as what it is:</text>
    <text x="125" y="296" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">never claims platform runs</text>

    <rect x="690" y="216" width="180" height="100" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="780" y="244" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-gov-text)">Roadmap (SMART+)</text>
    <text x="780" y="264" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">rehearse on the simulated</text>
    <text x="780" y="280" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">twin before hardware:</text>
    <text x="780" y="296" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">same instructions, no risk</text>

    <line x1="780" y1="166" x2="780" y2="196" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#lab-arr)"/>
    <text x="780" y="190" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">the IA evaluates</text>

    <text x="450" y="380" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">Your metrologists&#8217; expertise goes into measurement; the paperwork mechanics leave the bench.</text>
    <text x="450" y="404" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">The report an IA receives from you is data it can compute against, not prose it must trust.</text>

    <text x="450" y="456" text-anchor="middle" font-size="12" fill="var(--dg-text-muted)">The dispatch is one TestRequest per laboratory: your inbox shows exactly your share, live.</text>
  </svg>
</TechFigure>
