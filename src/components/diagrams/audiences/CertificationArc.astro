---
/**
 * CertificationArc — the Issuing Authority's arc in one diagram: review,
 * samples, dispatch, evaluation, issue (the CNML signature over the
 * verdict chain), registration with the BIML, verified anywhere — with
 * the laboratory's dispatch loop and the liability callout. House style;
 * dark-mode correct via the TechFigure palette. (TODO.promotion/10: one
 * diagram per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="One workflow from application to registration: every stage an act with a record, never an email.">
  <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ia-arc-title">
    <title id="ia-arc-title">The certification arc as the Issuing Authority runs it: review, samples, dispatch, evaluation, issue, register, verified anywhere; the laboratory works the dispatch and returns the report as data</title>

    <defs>
      <marker id="ia-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">The certification arc, as the Issuing Authority runs it</text>

    <rect x="30" y="70" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="120" y="98" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">1 &#183; Review</text>
    <text x="120" y="118" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the queue, oldest first;</text>
    <text x="120" y="134" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the whole file, one page</text>

    <rect x="240" y="70" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="330" y="98" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">2 &#183; Samples</text>
    <text x="330" y="118" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">request, shipment,</text>
    <text x="330" y="134" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">receipt registered</text>

    <rect x="450" y="70" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="540" y="98" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">3 &#183; Dispatch</text>
    <text x="540" y="118" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">test forms &#215; samples</text>
    <text x="540" y="134" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">to your laboratories</text>

    <rect x="660" y="70" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="750" y="98" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">4 &#183; Evaluation</text>
    <text x="750" y="118" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">verdicts computed from</text>
    <text x="750" y="134" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the evidence, not re-typed</text>

    <line x1="210" y1="108" x2="232" y2="108" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>
    <line x1="420" y1="108" x2="442" y2="108" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>
    <line x1="630" y1="108" x2="652" y2="108" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>

    <line x1="750" y1="146" x2="750" y2="196" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>

    <rect x="660" y="204" width="180" height="76" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="750" y="232" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-gen-text)">5 &#183; Issue</text>
    <text x="750" y="252" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">sign the CNML certificate</text>
    <text x="750" y="268" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">over the verdict chain</text>

    <rect x="450" y="204" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="540" y="232" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">6 &#183; Register</text>
    <text x="540" y="252" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the BIML registration act</text>
    <text x="540" y="268" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">publishes the valid copy</text>

    <rect x="240" y="204" width="180" height="76" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5"/>
    <text x="330" y="232" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-source-text)">7 &#183; Verified anywhere</text>
    <text x="330" y="252" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">number or file, no account,</text>
    <text x="330" y="268" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">no phone call to your desk</text>

    <line x1="660" y1="242" x2="638" y2="242" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>
    <line x1="450" y1="242" x2="428" y2="242" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ia-arr)"/>

    <rect x="30" y="204" width="180" height="76" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5" stroke-dasharray="6 4"/>
    <text x="120" y="232" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">Test Laboratory</text>
    <text x="120" y="252" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">works the dispatch, returns</text>
    <text x="120" y="268" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the test report as data</text>

    <line x1="540" y1="146" x2="140" y2="196" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#ia-arr)"/>
    <line x1="180" y1="204" x2="672" y2="150" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#ia-arr)"/>

    <rect x="30" y="330" width="810" height="100" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="60" y="360" font-size="14" font-weight="600" fill="var(--dg-gov-text)">Your signature, your liability: unchanged</text>
    <text x="60" y="384" font-size="12" fill="var(--dg-text-soft)">The platform does digitally what your authority does today: the same review, the same evaluation, the</text>
    <text x="60" y="402" font-size="12" fill="var(--dg-text-soft)">same decision. What it removes is the transcription and the archaeology: every verdict shows the</text>
    <text x="60" y="420" font-size="12" fill="var(--dg-text-soft)">evidence it was computed from, and suspension and withdrawal are first-class lifecycle acts.</text>

    <text x="450" y="464" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">One workflow from application to registration: every stage an act with a record, never an email.</text>
  </svg>
</TechFigure>
