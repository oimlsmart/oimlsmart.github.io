---
/**
 * CorrespondingMemberPosition — the Corresponding Member's position in
 * one diagram: every hosted service today, the Associate rendered as a
 * registry fact, and the one honest gap (self-hosting waits for
 * ratification — the Convention's ground, never the platform's to sell).
 * House style; dark-mode correct via the TechFigure palette.
 * (TODO.promotion/10: one diagram per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="Read access is never a vote; the platform keeps the Convention's categories exactly as they are.">
  <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="cm-position-title">
    <title id="cm-position-title">The Corresponding Member's position: every hosted service today, the Associate's designation rendered as a registry fact, and the single entitlement that waits for ratification</title>

    <defs>
      <marker id="cm-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">The Corresponding Member&#8217;s position: full hosted access, one honest gap</text>

    <rect x="40" y="70" width="250" height="110" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="165" y="98" text-anchor="middle" font-size="15" font-weight="600" fill="var(--dg-text)">CORRESPONDING MEMBER</text>
    <text x="165" y="120" text-anchor="middle" font-size="12" fill="var(--dg-text-soft)">participates without a vote;</text>
    <text x="165" y="138" text-anchor="middle" font-size="12" fill="var(--dg-text-soft)">the Convention governs that:</text>
    <text x="165" y="158" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">the platform serves it, never sells it</text>

    <rect x="360" y="60" width="500" height="54" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="610" y="82" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gen-text)">Every hosted service, today</text>
    <text x="610" y="101" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the OIML-CS SMART Platform &#183; the AI at the member tier &#183; the library &#183; verify &#183; the register</text>

    <rect x="360" y="128" width="500" height="54" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="610" y="150" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-text)">Your Associate, rendered as what it is</text>
    <text x="610" y="169" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the designation a registry fact linked to you; its Declaration standing visible, not filed away</text>

    <rect x="360" y="196" width="500" height="54" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="610" y="218" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-text)">The same evidence Member States read</text>
    <text x="610" y="237" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the Recommendations as models with clause-level provenance; the register; the verification surface</text>

    <line x1="290" y1="87" x2="352" y2="87" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#cm-arr)"/>
    <line x1="290" y1="155" x2="352" y2="155" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#cm-arr)"/>
    <line x1="290" y1="223" x2="352" y2="223" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#cm-arr)"/>

    <rect x="360" y="290" width="500" height="54" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5" stroke-dasharray="6 4"/>
    <text x="610" y="312" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gov-text)">The one entitlement that waits for ratification</text>
    <text x="610" y="331" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">self-hosting the platform software: your own instance, your data residency, streaming updates</text>

    <line x1="290" y1="317" x2="352" y2="317" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#cm-arr)"/>
    <text x="321" y="307" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">ratify</text>

    <rect x="40" y="290" width="250" height="54" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5" stroke-dasharray="6 4"/>
    <text x="165" y="312" text-anchor="middle" font-size="13" font-weight="600" fill="var(--dg-text)">MEMBER STATE</text>
    <text x="165" y="330" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the upward step is the OIML&#8217;s own</text>

    <rect x="40" y="390" width="820" height="50" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5"/>
    <text x="450" y="412" text-anchor="middle" font-size="12" fill="var(--dg-source-text)">Nothing to run: the hosted path never requires the self-host entitlement. Accounts for your</text>
    <text x="450" y="429" text-anchor="middle" font-size="12" fill="var(--dg-source-text)">personnel, your Associate&#8217;s standing rendered honestly, and every public surface is yours.</text>

    <text x="450" y="464" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">Read access is never a vote; the platform keeps the Convention&#8217;s categories exactly as they are.</text>
  </svg>
</TechFigure>
