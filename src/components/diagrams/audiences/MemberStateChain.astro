---
/**
 * MemberStateChain — the member state's chain in one diagram: the state
 * proposes and designates its bodies (PD-03 / the IA's scope), utilizer
 * bodies accept by Declaration (PD-08), certificates land in the BIML
 * register (B 18 §15.8), and anyone verifies. House style; dark-mode
 * correct via the TechFigure palette. (TODO.promotion/10: one diagram
 * per page.)
 */
import TechFigure from '../TechFigure.astro'
---

<TechFigure caption="Every link in the chain is a registry fact; every verdict traces to the clause that produced it.">
  <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ms-chain-title">
    <title id="ms-chain-title">The member state's chain: designation, custody, verification: the member state proposes its Issuing Authority and designates its laboratories, certificates register with the BIML, and anyone verifies</title>

    <defs>
      <marker id="ms-arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="var(--dg-arrow)"/>
      </marker>
    </defs>

    <text x="450" y="34" text-anchor="middle" font-size="20" font-weight="600" fill="var(--dg-text)">The member state&#8217;s chain: designation, custody, verification</text>

    <rect x="40" y="70" width="250" height="120" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="165" y="100" text-anchor="middle" font-size="15" font-weight="600" fill="var(--dg-gov-text)">MEMBER STATE</text>
    <text x="165" y="122" text-anchor="middle" font-size="12" fill="var(--dg-text-soft)">your regulation cites the</text>
    <text x="165" y="140" text-anchor="middle" font-size="12" fill="var(--dg-text-soft)">Recommendation, now a model</text>
    <text x="165" y="162" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">the entitled party: the platform self-hosts here</text>

    <rect x="360" y="60" width="220" height="64" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="470" y="86" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gen-text)">Issuing Authority</text>
    <text x="470" y="106" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">you propose it (PD-03); it issues</text>

    <rect x="360" y="146" width="220" height="64" rx="10" fill="var(--dg-gen-fill)" stroke="var(--dg-gen-stroke)" stroke-width="1.5"/>
    <text x="470" y="172" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-gen-text)">Test Laboratory</text>
    <text x="470" y="192" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">designated under the IA&#8217;s scope</text>

    <rect x="360" y="232" width="220" height="64" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="470" y="258" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-text)">Utilizer bodies</text>
    <text x="470" y="278" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">accept certificates by Declaration (PD-08)</text>

    <line x1="290" y1="92" x2="352" y2="92" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <text x="321" y="82" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">proposes</text>
    <line x1="290" y1="178" x2="352" y2="178" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <text x="321" y="168" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">designates</text>
    <line x1="290" y1="264" x2="352" y2="264" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <text x="321" y="254" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">recognizes</text>

    <rect x="650" y="60" width="210" height="64" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="755" y="86" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-text)">Certificates</text>
    <text x="755" y="106" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">signed CNML, machine-verifiable</text>

    <rect x="650" y="146" width="210" height="64" rx="10" fill="var(--dg-panel)" stroke="var(--dg-panel-stroke)" stroke-width="1.5"/>
    <text x="755" y="172" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-text)">BIML register</text>
    <text x="755" y="192" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">the validity reference (B 18 &#167;15.8)</text>

    <rect x="650" y="232" width="210" height="64" rx="10" fill="var(--dg-source-fill)" stroke="var(--dg-source-stroke)" stroke-width="1.5"/>
    <text x="755" y="258" text-anchor="middle" font-size="14" font-weight="600" fill="var(--dg-source-text)">Anyone verifies</text>
    <text x="755" y="278" text-anchor="middle" font-size="11" fill="var(--dg-text-soft)">no account, one lookup</text>

    <line x1="580" y1="92" x2="642" y2="92" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <line x1="755" y1="124" x2="755" y2="138" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <line x1="755" y1="210" x2="755" y2="224" stroke="var(--dg-arrow)" stroke-width="1.5" marker-end="url(#ms-arr)"/>
    <line x1="642" y1="264" x2="588" y2="264" stroke="var(--dg-arrow)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#ms-arr)"/>
    <text x="615" y="254" text-anchor="middle" font-size="11" fill="var(--dg-text-muted)">accepts</text>

    <rect x="40" y="330" width="820" height="100" rx="10" fill="var(--dg-gov-fill)" stroke="var(--dg-gov-stroke)" stroke-width="1.5"/>
    <text x="70" y="360" font-size="14" font-weight="600" fill="var(--dg-gov-text)">Custody never moves</text>
    <text x="70" y="384" font-size="12" fill="var(--dg-text-soft)">The text of every Recommendation stays; the model joins it. Self-host under your entitlement with</text>
    <text x="70" y="402" font-size="12" fill="var(--dg-text-soft)">streaming updates, or use the official hosted platform: the designation chain and the register</text>
    <text x="70" y="420" font-size="12" fill="var(--dg-text-soft)">render identically either way.</text>

    <text x="450" y="464" text-anchor="middle" font-size="13" fill="var(--dg-text-muted)">Every link in the chain is a registry fact; every verdict traces to the clause that produced it.</text>
  </svg>
</TechFigure>
