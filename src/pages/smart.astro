---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import TierToggle from '../components/TierToggle.astro'
import ComponentLogo from '../components/ComponentLogo.astro'

const workflow = [
  { step: 'Application', desc: 'the applicant files for type evaluation against a modelled Recommendation, identity, classification, the model family matrix.' },
  { step: 'Sample request', desc: 'the issuing authority requests samples of the type; the chain of custody starts here, every hand-off recorded.' },
  { step: 'Dispatch', desc: 'the application goes to a test laboratory as a structured test request, per form, per requirement set, never a PDF in an email.' },
  { step: 'Lab test runs', desc: 'the laboratory executes the conformance tests; evidence is captured once, at the bench, against the form the Recommendation declares.' },
  { step: 'Evaluation', desc: 'the test reports roll up into a type evaluation, every verdict computed from the requirement model, none asserted by hand.' },
  { step: 'CNML-signed certificate', desc: 'the authority issues the certificate as a signed CNML document, the verdict chain, signed, verifiable by anyone.' },
  { step: 'BIML registration', desc: 'the certificate registers with the BIML, the public register is the same database the workflow wrote to all along.' },
]

const consoles = [
  { name: 'Applicant portal', role: 'the manufacturer', desc: 'File the application, declare the model family, ship samples, watch the verdicts arrive, status is a query, not a phone call.' },
  { name: 'IA console', role: 'the issuing authority', desc: 'Review applications, request samples, dispatch test requests, judge the evaluation, sign and issue the certificate.' },
  { name: 'TL workbench', role: 'the test laboratory', desc: 'The lab inbox, the structured test run, evidence capture at the bench, the test report generated from the run itself.' },
  { name: 'BIML console', role: 'the register', desc: 'Registration of issued certificates, the participant registry, the public record, the system of the OIML-CS, operated by the Bureau.' },
]

const deployments = [
  { mode: 'Shared', name: 'BIML-operated', desc: 'One hosted platform serves every issuing authority and test laboratory. The register is built in; participation is an account, not an installation.' },
  { mode: 'Local + submission', name: 'IA-operated', desc: 'An issuing authority runs its own instance under its own custody; signed submissions flow into the shared register, which verifies the signature chain on import.' },
]

const smartplusLifecycle = [
  { step: 'Type-instance enrolment', desc: 'a manufactured instrument of a certified type is enrolled against its Type-approval baseline; the twin is registered, the chain to the type begins.' },
  { step: 'Calibration', desc: 'initial calibration captures the instrument-specific parameters, signed by the calibrating lab, attached to the instance twin.' },
  { step: 'In-service measurements', desc: 'the instrument reports measurement streams — each reading signed, timestamped, traceable to the instance twin and through it to the type.' },
  { step: 'Continuous conformance', desc: 'conformance runs against the SMART Recommendation continuously, not episodically; deviations are events, not incidents discovered at re-verification.' },
  { step: 'Re-verification', desc: 'scheduled and event-triggered re-verifications run the same test programs against the live twin; verdicts update the instance certificate.' },
  { step: 'Withdrawal', desc: 'end-of-life or withdrawal cancels the instance certificate; the type certificate remains; the registry reflects the change immediately.' },
]

const smartplusConsoles = [
  { name: 'Operator console', role: 'the instrument user', desc: 'The instrument in service, its current conformance state, its measurement stream, alerts the moment a parameter drifts.' },
  { name: 'IA instance console', role: 'the issuing authority', desc: 'Type-instance certificates under the IA’s custody, the population of instruments in the field, the re-verification schedule.' },
  { name: 'TL bench console', role: 'the test laboratory', desc: 'Re-verification runs, calibration updates, evidence captured at the bench against the live twin, not a paper record.' },
  { name: 'BIML SMART+ register', role: 'the register', desc: 'The cross-border registry of Type-instance certificates, the verifier for instruments in service across member states.' },
]
---

<Base
  title="The OIML-CS SMART Platform"
  description="The OIML-CS global deployment of the SMART runtime: SMART tier covers Type-approval; SMART+ extends to the full instrument-instance lifecycle."
>
  <PageHero
    logo={{ name: "cs-smart", alt: "The OIML-CS SMART platform logo." }}
    title="The OIML-CS SMART platform"
    lede="The OIML-CS global deployment of the SMART runtime. SMART tier: Type-approval workflow, application to BIML registration. SMART+ tier: the same runtime extended to every certified instrument in service."
  />

  <div class="px-8 pb-20 max-w-5xl">
    <TierToggle default="smart" />

    <div data-tier="smart">
      {/* § 01, the certification workflow */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 01</span>
          <span>The certification workflow</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">B 18:2025 · end to end</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The OIML-CS workflow, modelled end to end on <strong class="text-ink font-semibold">B 18:2025</strong>.
          Every participant role, every document, every verdict is an entity in the system, so the whole
          chain is traceable, and every state change carries its evidence.
        </p>
        <figure class="border border-rule rounded-md bg-paper-soft p-6 mb-6">
          <img src="/diagrams/shared/workflow-chain.svg" alt="The OIML-CS workflow chain: application through sampling, dispatch, testing, evaluation, certificate issuance, and registration" class="w-full max-w-3xl mx-auto" loading="lazy" />
        </figure>
        <ol class="list-none p-0 m-0 flex flex-col border border-rule rounded-md overflow-hidden">
          {workflow.map((w, i) => (
            <li class="flex gap-5 items-baseline bg-paper-soft p-5 border-b border-rule last:border-b-0 bp-card-hover">
              <span class="font-mono text-xs text-accent whitespace-nowrap">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-serif text-[1.0625rem] inline">{w.step}</h3>
                <span class="text-sm text-ink-soft">, {w.desc}</span>
              </div>
            </li>
          ))}
        </ol>
        <p class="text-sm text-ink-muted mt-4">
          The scheme itself, the roles, the documents, the governance, is on <a class="text-accent underline underline-offset-2" href="/oiml-cs">the OIML-CS page</a>; the certificate format is <a class="text-accent underline underline-offset-2" href="/cnml">OIML CNML</a>.
        </p>
      </section>

      {/* § 02, the four consoles */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 02</span>
          <span>The four consoles</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">one seat per role</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          Every participant in the OIML-CS gets a console shaped to their role in the workflow,
          the same underlying model in four different seats.
        </p>
        <div class="grid grid-cols-2 gap-px bg-rule border border-rule rounded-md overflow-hidden max-[960px]:grid-cols-1">
          {consoles.map((c) => (
            <div class="bg-paper-soft p-5 bp-card-hover">
              <div class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent mb-1">{c.role}</div>
              <h3 class="font-serif text-[1.125rem] mb-1.5">{c.name}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{c.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* § 03, history */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 03</span>
          <span>History</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">1991 → B 18:2025</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The OIML Certificate System for Measuring Instruments began in 1991 as a paper workflow:
          applications by mail, test reports as documents, certificates as signed paper. OIML B 18, the
          Framework for the OIML Certification System, defines the current scheme, and the 2025 edition
          (B 18:2025) names digital operation as the direction. The platform is that direction built:
          the scheme's roles, documents, and decisions modelled as entities and processes, so the
          workflow the Basic Publication describes is the workflow the system runs.
        </p>
      </section>

      {/* § 04, the deployment modes */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 04</span>
          <span>Two deployment modes</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">shared · local + submission</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The platform runs where the authority needs it: as the shared system the BIML operates for
          everyone, or as an authority's own instance whose signed submissions the shared register
          accepts. The member-state deployment is the <a class="text-accent underline underline-offset-2" href="/platform">OIML SMART Platform</a>.
        </p>
        <div class="grid grid-cols-2 gap-4 max-[960px]:grid-cols-1">
          {deployments.map((d) => (
            <article class="bg-paper-soft border border-rule rounded-md p-5 bp-card-hover">
              <div class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent mb-1">{d.mode}</div>
              <h3 class="font-serif text-[1.125rem] mb-1.5">{d.name}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{d.desc}</p>
            </article>
          ))}
        </div>
      </section>
    </div>

    <div data-tier="smartplus">
      {/* SMART+ § 01, the instance lifecycle */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 01</span>
          <span>The instrument-instance lifecycle</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">Type-instance · measurement</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The SMART+ tier extends the same runtime to the individual certified instrument. Every
          type-instance in service carries a twin; every measurement is signed and traceable; every
          conformance verdict runs against the SMART Recommendation continuously. The Type-approval
          baseline (the SMART-tier output) is the contract; the SMART+ lifecycle is the instrument
          fulfilling it, in the field, over time.
        </p>
        <ol class="list-none p-0 m-0 flex flex-col border border-rule rounded-md overflow-hidden">
          {smartplusLifecycle.map((w, i) => (
            <li class="flex gap-5 items-baseline bg-paper-soft p-5 border-b border-rule last:border-b-0 bp-card-hover">
              <span class="font-mono text-xs text-accent whitespace-nowrap">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-serif text-[1.0625rem] inline">{w.step}</h3>
                <span class="text-sm text-ink-soft">, {w.desc}</span>
              </div>
            </li>
          ))}
        </ol>
        <p class="text-sm text-ink-muted mt-4">
          The instrument twin is <a class="text-accent underline underline-offset-2" href="/smi">SMART Measuring Instruments</a>; the simulated twin for bench work is <a class="text-accent underline underline-offset-2" href="/sst">SST</a>; the instance certificate is <a class="text-accent underline underline-offset-2" href="/cnml#smartplus">OIML CNML at the Type-instance level</a>.
        </p>
      </section>

      {/* SMART+ § 02, consoles */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 02</span>
          <span>The SMART+ consoles</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">field · bench · register</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The SMART+ tier adds the operator seat and reshapes the laboratory and authority consoles
          around the live twin, not the paper record.
        </p>
        <div class="grid grid-cols-2 gap-px bg-rule border border-rule rounded-md overflow-hidden max-[960px]:grid-cols-1">
          {smartplusConsoles.map((c) => (
            <div class="bg-paper-soft p-5 bp-card-hover">
              <div class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent mb-1">{c.role}</div>
              <h3 class="font-serif text-[1.125rem] mb-1.5">{c.name}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{c.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* SMART+ § 03, deployment */}
      <section class="mb-16 bp-reveal">
        <div class="bp-section-anchor mb-4">
          <span class="bp-section-anchor__num">§ 03</span>
          <span>Global register, member deployments</span>
          <span class="bp-section-anchor__line"></span>
          <span class="bp-coord">Type-instance registry · cross-border</span>
        </div>
        <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
          The OIML-CS SMART+ Platform is the global registry of Type-instance certificates and the
          cross-border verifier for instruments in service. Member states, NMIs, and laboratories may
          run their own <a class="text-accent underline underline-offset-2" href="/platform#smartplus">OIML SMART+ Platform</a> under national custody, federating instance data upstream.
        </p>
        <div class="grid grid-cols-2 gap-4 max-[960px]:grid-cols-1">
          <article class="bg-paper-soft border border-rule rounded-md p-5 bp-card-hover">
            <ComponentLogo name="cs-smartplus" alt="The OIML-CS SMART+ platform logo." width={96} class="mb-3 block" />
            <div class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent mb-1">Global · SMART+</div>
            <h3 class="font-serif text-[1.125rem] mb-1.5">OIML-CS SMART+ Platform</h3>
            <p class="text-sm text-ink-soft leading-relaxed">BIML-operated registry of Type-instance certificates. The cross-border verifier for instruments in service across member states.</p>
          </article>
          <article class="bg-paper-soft border border-rule rounded-md p-5 bp-card-hover">
            <ComponentLogo name="smartplus" alt="The OIML SMART+ Platform logo." width={96} class="mb-3 block" />
            <div class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent mb-1">Member · SMART+</div>
            <h3 class="font-serif text-[1.125rem] mb-1.5">OIML SMART+ Platform</h3>
            <p class="text-sm text-ink-soft leading-relaxed">Member-state deployment of the SMART+ runtime. Instance data under national custody, federated with the global register.</p>
          </article>
        </div>
      </section>
    </div>

    {/* § 05, try it (shared across tiers) */}
    <section class="mb-16 bp-reveal">
      <div class="bp-section-anchor mb-4">
        <span class="bp-section-anchor__num">§ 05</span>
        <span>Try the workflow</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">in your browser</span>
      </div>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
        The pilot build runs the whole chain in your browser, seed a sample application, dispatch it,
        run the tests against the simulated instrument, evaluate, and issue the certificate.
      </p>
      <div class="flex flex-wrap gap-3 mb-10">
        <a class="btn btn-primary bp-focus-ring" href="/app">Open the app →</a>
        <a class="btn btn-ghost bp-focus-ring" href="/sst">The simulated instruments →</a>
        <a class="btn btn-ghost bp-focus-ring" href="/programs/oiml-smart">The program overview →</a>
      </div>
    </section>
  </div>
</Base>
