---
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import ActionBox from '../../components/ActionBox.astro'

// TODO.promotion/05: the six use-case stories, each at the page-depth
// anatomy of 10 (the hero + the performed walkthrough + one diagram +
// the SMART/SMART+ split + the objections FAQ + the journey CTAs),
// every capture regenerated by scripts/capture-usecases.ts.
const useCases = [
  {
    href: '/use-cases/type-evaluation-end-to-end',
    title: 'Type evaluation, end to end',
    desc: 'The canonical arc as one continuous story: apply, review, dispatch, test, evaluate, decide, issue, publish to the register, verify anywhere. The five demo flows as chapters, the per-role pages linked.',
  },
  {
    href: '/use-cases/deployment-modes',
    title: 'The deployment-mode matrix',
    desc: 'One codebase, four postures: the CS-operated platform, IA-only, TL-only, IA+TL. What each runs, who signs in, what federates where, and the start-small path.',
  },
  {
    href: '/use-cases/continuous-compliance',
    title: 'Continuous compliance via the twin',
    desc: 'The SMART+ story: the instrument’s live twin monitored against its Recommendation’s promises, evidence accumulating for audit, suspension semantics when a promise breaks. Roadmap-anchored.',
    smartplus: true,
  },
  {
    href: '/use-cases/training-on-the-sst',
    title: 'Training on the SST',
    desc: 'Rehearse the full test program on the simulated instrument before touching hardware; the platform drives the simulation directly, and the bench keeps the truth visible.',
  },
  {
    href: '/use-cases/member-state-view',
    title: 'The member-state view',
    desc: 'The designation chain as the honest registry story: your authorities and their scopes, the issued work on the public register, the utilizers’ access, verification without an account.',
  },
  {
    href: '/use-cases/additional-national-requirements',
    title: 'The additional-national-requirements flow',
    desc: 'ANRs on top of the Recommendation: the Primmel-defined path and the tick-a-box path, moderated declarations, the dispatch and the certificate covering the declared set.',
  },
]
---

<Base
  title="Use Cases"
  description="OIML SMART use cases: the certification workflow told end to end, from the manufacturer's application to the registered certificate, and continuous compliance while the instrument is in service."
>
  <PageHero
    title="Use Cases"
    lede="Certification, told as stories: who does what, what the system computes, and what lands on the record. Every story walks the live demo, not a mock-up."
  />

  <section class="px-8 pb-20 max-w-5xl">
    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What you do today</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft mb-4">
        A type evaluation is a project run on files and folders: the application as a scanned form, the test schedule as a spreadsheet, the test report as a document assembled by hand, the certificate as a PDF. Progress is tracked by asking, and the audit trail is whoever kept the email thread.
      </p>
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What changes</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft mb-4">
        The evaluation becomes one shared record the applicant, the laboratory, and the authority all work in. The forms derive from the Recommendation's model, the evidence attaches to the test it proves, the verdicts are computed, and the certificate is issued from the same record. Nothing is re-typed, and the record itself is the audit trail.
      </p>
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What you can try now</h2>
      <ActionBox
        href="https://demo.oimlsmart.org/"
        label="Open the live demo"
        description="The full workflow against a simulated load cell: apply, test, evaluate, issue. The one-click demo accounts need no registration; the instance resets nightly."
      />
      <ActionBox
        href="/use-cases/type-evaluation-end-to-end"
        label="Walk the canonical arc first"
        description="The end-to-end story links every chapter to the exact live step, the demo account named where a sign-in is needed."
      />
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">Who to talk to</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft">
        Write to <a class="text-accent underline underline-offset-2" href="mailto:info@oimlsmart.org">info@oimlsmart.org</a> to walk through any of these stories with the programme team.
      </p>
    </div>

    <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">The stories</h2>
    <div class="grid grid-cols-2 gap-4 max-[960px]:grid-cols-1">
      {useCases.map(u => (
        <a href={u.href} class="group block border border-rule rounded-md bg-paper-soft p-6 no-underline text-inherit transition-all hover:border-accent hover:shadow-md">
          <h3 class="font-serif text-[1.25rem] mb-2 text-ink group-hover:text-accent transition-colors">{u.title}</h3>
          <p class="text-[0.9375rem] text-ink-soft mb-3">{u.desc}</p>
          {u.smartplus
            ? <span class="text-ink-muted text-sm font-mono">SMART+ · roadmap-anchored</span>
            : <span class="text-accent text-sm font-mono">Read the story →</span>}
        </a>
      ))}
    </div>
  </section>
</Base>
