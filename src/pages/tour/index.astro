---
import Base from '../../layouts/Base.astro'
import ShotFigure from '../../components/ShotFigure.astro'
import TourEstateMap from '../../components/diagrams/TourEstateMap.astro'
import { TOUR_SLIDES, TOUR_CAPTURED } from '../../data/tour-slides'

// The CIML tour (TODO.promotion/07): the interactive "Digital OIML"
// presentation. One source (src/data/tour-slides.ts) feeds this deck and
// the presenter notes at /tour/notes. Deep links: /tour#s07 addresses
// slide 7 directly (the hash is the shareable URL per slide; without
// JavaScript the deck renders as one continuous document and the
// anchors still land). Keyboard/clicker: arrows, PageUp/PageDown, space,
// Home/End; on-screen buttons for the mouse. Online, every demo moment
// is a link into demo.oimlsmart.org at the exact console/step; offline,
// the dated capture on the same slide carries the moment.

const total = TOUR_SLIDES.length
const n = (i: number) => String(i + 1).padStart(2, '0')
---

<Base
  title="The CIML tour: the Digital OIML, live"
  description="The interactive OIML SMART presentation for the committee: the problem said kindly, the estate map, the five demo flows with one live step each, the technologies, the deployment modes, the interop position, the governance posture, the adoption path, and the ask. Keyboard navigable, deep-linkable per slide, online-live and offline-degraded."
>
  <div class="tour-deck" data-total={total}>
    <div class="tour-topline">
      <p class="tour-topline__crumb">
        <a href="/tour">The CIML tour</a> · <a href="/tour/notes">presenter notes</a> · <a href="/about/audiences/one-pagers/">the leave-behind one-pagers</a>
      </p>
      <p class="tour-topline__net" data-net hidden></p>
    </div>

    <div class="tour-stage">
      {TOUR_SLIDES.map((s, i) => (
        <section class="tour-slide" id={s.id} data-slide={s.id} aria-label={`Slide ${i + 1} of ${total}: ${s.title}`}>
          <header class="tour-slide__head">
            <p class="tour-slide__kicker">
              <span>{s.kicker}</span>
              {s.chip && <span class:list={['tour-chip', `tour-chip--${s.chip === 'SMART+' ? 'plus' : 'smart'}`]}>{s.chip}</span>}
            </p>
            <h2 class="tour-slide__title">{s.title}</h2>
            <p class="tour-slide__lede">{s.lede}</p>
          </header>

          <div class:list={['tour-slide__body', { 'tour-slide__body--split': s.live }]}>
            <div class="tour-slide__main">
              {s.bullets && (
                <ul class="tour-slide__bullets">
                  {s.bullets.map(b => <li>{b}</li>)}
                </ul>
              )}

              {s.diagram === 'estate-map' && <TourEstateMap />}

              {s.live && (
                <div class="tour-live">
                  <p class="tour-live__row">
                    <a class="tour-live__cta" href={s.live.href} target="_blank" rel="noopener noreferrer">Open the live step ↗</a>
                    <span class="tour-live__account">
                      {s.live.account === 'no account' ? 'no account needed' : <>sign in as <strong>{s.live.account}</strong></>} · <code>{s.live.console}</code>
                    </span>
                  </p>
                  <p class="tour-live__action">{s.live.action}</p>
                  <p class="tour-live__walk">
                    The whole flow, narrated: <a href={s.live.walkthrough.href}>{s.live.walkthrough.label}</a> · {s.live.walkthrough.desc}.
                  </p>
                </div>
              )}

              {s.links && (
                <ul class="tour-links">
                  {s.links.map(l => (
                    <li>
                      <a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}{l.href.startsWith('http') ? ' ↗' : ''}</a>
                      {l.desc && <span class="tour-links__desc">{l.desc}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {s.live && (
              <div class="tour-slide__shot">
                <ShotFigure
                  section="walkthroughs"
                  page={s.live.shot.page}
                  stem={s.live.shot.stem}
                  alt={s.live.shot.alt}
                  source={s.live.href}
                  captured={TOUR_CAPTURED}
                  dark={s.live.shot.dark}
                />
                <p class="tour-shot-note">The no-network room: this dated capture carries the moment.</p>
              </div>
            )}
          </div>

          <footer class="tour-slide__foot">
            <a class="tour-slide__anchor" href={`#${s.id}`} title="The shareable address of this slide">#{s.id}</a>
            <span class="tour-slide__count">{n(i)} / {total}</span>
          </footer>
        </section>
      ))}
    </div>

    <nav class="tour-controls" aria-label="Slide navigation">
      <button type="button" class="tour-btn" data-prev aria-label="Previous slide">← prev</button>
      <span class="tour-controls__pos" data-pos>1 / {total}</span>
      <button type="button" class="tour-btn" data-next aria-label="Next slide">next →</button>
      <span class="tour-controls__hint">arrows · space · PgUp/PgDn · Home/End · <a href="/tour/notes">the presenter notes</a></span>
    </nav>
  </div>

  <style is:global>
    .tour-deck {
      max-width: 72rem;
      margin: 0 auto;
      padding: 1.5rem 1.5rem 0;
    }
    .tour-topline {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .tour-topline__crumb {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      color: var(--ink-muted);
      margin: 0;
    }
    .tour-topline__crumb a { color: var(--accent); text-decoration: none; }
    .tour-topline__crumb a:hover { text-decoration: underline; }
    .tour-topline__net {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      margin: 0;
      padding: 0.15rem 0.6rem;
      border: 1px solid var(--rule);
      border-radius: 999px;
      color: var(--ink-soft);
    }
    .tour-topline__net[data-net='offline'] {
      color: var(--accent);
      border-color: var(--accent);
    }

    /* Without JavaScript the deck is one continuous document; the script
       flips .is-live on and the stage shows one slide at a time. */
    .tour-slide {
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: var(--paper);
      padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 3.5vw, 3rem);
      margin-bottom: 2rem;
      scroll-margin-top: 5rem;
    }
    .tour-deck.is-live .tour-slide { display: none; margin-bottom: 0; }
    .tour-deck.is-live .tour-slide.is-active {
      display: block;
      min-height: min(46rem, calc(100vh - 15rem));
    }

    .tour-slide__kicker {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin: 0 0 0.75rem;
    }
    .tour-chip {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 0.1rem 0.5rem;
      border-radius: 3px;
    }
    .tour-chip--smart {
      color: var(--accent);
      border: 1px solid var(--accent);
    }
    .tour-chip--plus {
      color: #b45309;
      border: 1px solid #d97706;
      background: rgba(217, 119, 6, 0.08);
    }
    .dark .tour-chip--plus {
      color: #fbbf24;
      border-color: #fbbf24;
      background: rgba(251, 191, 36, 0.08);
    }
    .tour-slide__title {
      font-family: var(--font-serif);
      font-size: clamp(1.75rem, 3.5vw, 2.75rem);
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.1;
      color: var(--ink);
      margin: 0 0 0.875rem;
    }
    .tour-slide__lede {
      font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 62ch;
      margin: 0 0 1.5rem;
    }
    .tour-slide__body--split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
    @media (max-width: 60rem) {
      .tour-slide__body--split { grid-template-columns: 1fr; }
    }
    .tour-slide__bullets {
      list-style: none;
      margin: 0 0 1.25rem;
      padding: 0;
      display: grid;
      gap: 0.625rem;
    }
    .tour-slide__bullets li {
      position: relative;
      padding-left: 1.25rem;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--ink-soft);
    }
    .tour-slide__bullets li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.6em;
      width: 0.5rem;
      height: 2px;
      background: var(--accent);
    }
    .tour-slide__bullets strong { color: var(--ink); }

    .tour-live {
      border-left: 3px solid var(--accent);
      padding: 0.25rem 0 0.25rem 1rem;
      margin: 0 0 1.25rem;
    }
    .tour-live__row {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
      flex-wrap: wrap;
      margin: 0 0 0.5rem;
    }
    .tour-live__cta {
      display: inline-block;
      font-weight: 600;
      font-size: 1rem;
      color: var(--paper);
      background: var(--accent);
      border-radius: 6px;
      padding: 0.45rem 1rem;
      text-decoration: none;
    }
    .tour-live__cta:hover { opacity: 0.9; }
    .tour-live__account {
      font-size: 0.875rem;
      color: var(--ink-muted);
    }
    .tour-live__account strong { color: var(--ink-soft); }
    .tour-live__account code { font-size: 0.8125rem; }
    .tour-live__action {
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--ink-soft);
      margin: 0 0 0.375rem;
    }
    .tour-live__walk {
      font-size: 0.875rem;
      color: var(--ink-muted);
      margin: 0;
    }
    .tour-live__walk a { color: var(--accent); }

    .tour-links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.5rem;
    }
    .tour-links li {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      flex-wrap: wrap;
      font-size: 0.9375rem;
    }
    .tour-links a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .tour-links__desc { color: var(--ink-muted); }

    .tour-slide__shot :global(.shot-figure) { margin: 0; }
    .tour-shot-note {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-muted);
      margin: 0.5rem 0 0;
    }

    .tour-slide__foot {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-top: 1px solid var(--rule);
      margin-top: 1.75rem;
      padding-top: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-muted);
    }
    .tour-slide__anchor { color: var(--accent); text-decoration: none; }
    .tour-slide__anchor:hover { text-decoration: underline; }

    .tour-controls {
      position: sticky;
      bottom: 0;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.625rem 0.25rem;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      z-index: 10;
    }
    .tour-deck:not(.is-live) .tour-controls { visibility: hidden; }
    .tour-btn {
      font: inherit;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--accent);
      background: transparent;
      border: 1px solid var(--accent);
      border-radius: 6px;
      padding: 0.35rem 1rem;
      cursor: pointer;
    }
    .tour-btn:hover { background: var(--paper-soft); }
    .tour-btn[disabled] { opacity: 0.4; cursor: default; }
    .tour-controls__pos {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--ink);
      min-width: 4.5rem;
      text-align: center;
    }
    .tour-controls__hint {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-muted);
    }
    .tour-controls__hint a { color: var(--accent); text-decoration: none; }
    @media (max-width: 48rem) {
      .tour-controls__hint { display: none; }
    }

    /* The printed deck: every slide, one per page, no chrome. */
    @media print {
      body > *:not(main) { display: none !important; }
      .tour-topline, .tour-controls { display: none !important; }
      .tour-deck, .tour-deck.is-live { max-width: none; padding: 0; }
      .tour-deck.is-live .tour-slide,
      .tour-slide { display: block !important; min-height: 0 !important; break-after: page; border: none; padding: 0.5rem 0; }
      .tour-slide__title { font-size: 20pt; }
      .tour-slide__lede { font-size: 11pt; }
      .tour-slide__bullets li { font-size: 10.5pt; }
      .tour-slide__shot { max-width: 32rem; }
    }
  </style>

  <script>
    // The deck driver: hash deep links (/tour#s07 is the shareable
    // address of slide 7), keyboard/clicker navigation, the offline
    // indicator. No network calls; the page is fully static.
    function initTour() {
      const deck = document.querySelector('.tour-deck')
      if (!deck) return
      const slides = Array.from(deck.querySelectorAll('.tour-slide'))
      const pos = deck.querySelector('[data-pos]')
      const prevBtn = deck.querySelector('[data-prev]')
      const nextBtn = deck.querySelector('[data-next]')
      const net = deck.querySelector('[data-net]')
      const ids = slides.map(s => s.id)
      let current = 0

      function indexFromHash() {
        const h = window.location.hash.replace('#', '')
        const byId = ids.indexOf(h)
        if (byId >= 0) return byId
        const byNum = parseInt(h, 10)
        if (!Number.isNaN(byNum) && byNum >= 1 && byNum <= slides.length) return byNum - 1
        return 0
      }

      function show(i, updateHash = true, scroll = false) {
        current = Math.max(0, Math.min(slides.length - 1, i))
        slides.forEach((s, k) => s.classList.toggle('is-active', k === current))
        if (pos) pos.textContent = `${current + 1} / ${slides.length}`
        if (prevBtn) prevBtn.toggleAttribute('disabled', current === 0)
        if (nextBtn) nextBtn.toggleAttribute('disabled', current === slides.length - 1)
        if (updateHash && window.location.hash !== `#${ids[current]}`) {
          history.replaceState(null, '', `#${ids[current]}`)
        }
        if (scroll) {
          // The native anchor jump ran before the deck went live; land the
          // active slide cleanly under the sticky header instead.
          if (current === 0) window.scrollTo({ top: 0 })
          else slides[current].scrollIntoView({ block: 'start' })
        }
      }

      deck.classList.add('is-live')
      show(indexFromHash(), false, true)

      prevBtn?.addEventListener('click', () => { show(current - 1, true, true); prevBtn.blur() })
      nextBtn?.addEventListener('click', () => { show(current + 1, true, true); nextBtn.blur() })

      document.addEventListener('keydown', (e) => {
        const t = e.target
        const tag = t && t.tagName ? t.tagName : ''
        if (['A', 'BUTTON', 'INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) return
        if (e.metaKey || e.ctrlKey || e.altKey) return
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
          e.preventDefault(); show(current + 1, true, true)
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault(); show(current - 1, true, true)
        } else if (e.key === 'Home') {
          e.preventDefault(); show(0, true, true)
        } else if (e.key === 'End') {
          e.preventDefault(); show(slides.length - 1, true, true)
        }
      })

      window.addEventListener('hashchange', () => show(indexFromHash(), false, true))

      function netState() {
        if (!net) return
        const off = !navigator.onLine
        net.hidden = false
        net.setAttribute('data-net', off ? 'offline' : 'online')
        net.textContent = off
          ? 'offline: the dated captures carry the demo moments'
          : 'online: the demo moments link into demo.oimlsmart.org'
      }
      window.addEventListener('online', netState)
      window.addEventListener('offline', netState)
      netState()
    }
    document.addEventListener('astro:page-load', initTour)
  </script>
</Base>
