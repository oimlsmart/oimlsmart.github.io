---
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import ActionBox from '../../components/ActionBox.astro'

// The services directory: every card links a live service (each URL
// verified at authoring time; the lychee gate re-proves them on every
// build). The per-service pages land in TODO.promotion wave 04.
const services = [
  {
    title: 'Who can run what',
    desc: 'The entitlement matrix: which services each member category can use on the hosted estate, and which they may run themselves.',
    href: '/services/who-can-run-what',
  },
  {
    title: 'The certification platform',
    desc: 'The workflow itself: application, testing, evaluation, certificate. Runs on this site; sign in with your estate account.',
    href: '/app/',
  },
  {
    title: 'The demo instance',
    desc: 'A full platform deployment pre-loaded with the simulated load-cell pilot. Demo accounts on request.',
    href: 'https://demo.oimlsmart.org/',
  },
  {
    title: 'The identity service',
    desc: 'One account for the whole estate; member deployments federate with it instead of running their own user directories.',
    href: 'https://id.oimlsmart.org/',
  },
  {
    title: 'The studio viewer',
    desc: 'The read-only viewer over the published SMART models: tree, canvas, code, and mapping lenses, with diff and validation.',
    href: 'https://www.oimlsmart.org/studio/view/',
  },
  {
    title: 'The vocabulary service',
    desc: 'The OIML SMART vocabularies, browsable and addressable: every term with its own URL.',
    href: 'https://www.oimlsmart.org/vocab/',
  },
  {
    title: 'The status service',
    desc: 'Live status of every service in the estate. No account needed.',
    href: 'https://status.oimlsmart.org/',
  },
  {
    title: 'The AI service',
    desc: 'Ask questions across the OIML library; every answer cites the publications it drew from.',
    href: 'https://ai.oimlsmart.org/',
  },
]
---

<Base
  title="Services"
  description="The OIML SMART services directory: the certification platform, the demo instance, the identity service, the studio viewer, the vocabulary service, the status service, and the AI service."
>
  <PageHero
    title="Services"
    lede="Everything the programme operates, in one directory. Each entry is a running service you can open now; where a sign-in is needed, the entry says so."
  />

  <section class="px-8 pb-20 max-w-5xl">
    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What you do today</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft mb-4">
        Access is per tool and per project: an account for the document portal, another for the scheme database, certificates arriving as email attachments, and no way to see whether any of it is up until it fails you.
      </p>
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What changes</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft mb-4">
        One identity spans the estate, every artifact is addressable by URL, and one status page tells you what is running. The services below are the whole estate as it stands; nothing is hidden behind a brochure.
      </p>
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">What you can try now</h2>
      <ActionBox
        href="https://status.oimlsmart.org/"
        label="Check the estate's pulse"
        description="The live status of every service below. No account needed."
      />
      <ActionBox
        href="https://demo.oimlsmart.org/"
        label="Open the demo instance"
        description="The full platform with the pilot data loaded. Sign in with a demo account; request one via info@oimlsmart.org."
      />
    </div>

    <div class="max-w-3xl mb-12">
      <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">Who to talk to</h2>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft">
        Access, accounts, and service questions: <a class="text-accent underline underline-offset-2" href="mailto:info@oimlsmart.org">info@oimlsmart.org</a>.
      </p>
    </div>

    <h2 class="font-serif text-[clamp(1.5rem,3vw,2rem)] font-medium tracking-[-0.01em] mb-4">The services</h2>
    <div class="grid grid-cols-2 gap-4 max-[960px]:grid-cols-1">
      {services.map(s => (
        <a href={s.href} class="group border border-rule rounded-md bg-paper-soft p-6 no-underline text-inherit transition-colors hover:border-accent">
          <h3 class="font-serif text-[1.25rem] mb-2 group-hover:text-accent">{s.title}</h3>
          <p class="text-[0.9375rem] text-ink-soft">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
