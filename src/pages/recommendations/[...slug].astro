---
import { getCollection } from 'astro:content'
import ContentPage from '../../layouts/ContentPage.astro'

export async function getStaticPaths() {
  const pages = await getCollection('pages')
  return pages
    // The per-Recommendation browser pages (the standards.ts contract:
    // every STANDARD has /library/<slug>/ + /recommendations/<slug>/).
    // The component home /recs belongs to the recs repo's minisite.
    .filter(p => p.id.startsWith('recommendations/'))
    .map(entry => {
      const slug = entry.id.replace('recommendations/', '')
      return { params: { slug }, props: { entry } }
    })
}

const { entry } = Astro.props
---

<ContentPage entry={entry} />