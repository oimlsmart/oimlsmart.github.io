---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'

const anatomy = [
  { part: 'The Recommendation identity', desc: 'which Recommendation — and which edition — the certificate evaluates against, pinned by its URN.' },
  { part: 'The certified type', desc: 'the instrument type and its classification — the identity the whole OIML-CS workflow established.' },
  { part: 'The characteristics', desc: 'the per-Recommendation characteristics of the type, validated against that Recommendation\u2019s JSON Schema before signing.' },
  { part: 'The test reports', desc: 'the evidence the certificate stands on — the reports the laboratories produced, named in the document.' },
  { part: 'The signature', desc: 'an XMLDSig signature over all of it — the issuing authority\u2019s key, on the threshold-cryptography PKI.' },
]

const checks = [
  { name: 'xml-well-formed', desc: 'the document parses as XML — the container is intact.' },
  { name: 'schema-valid', desc: 'the content validates against its per-Recommendation JSON Schema.' },
  { name: 'signature', desc: 'the XMLDSig signature verifies against the signer\u2019s public key.' },
  { name: 'scope', desc: 'the signer was entitled to issue for this Recommendation and scheme scope.' },
  { name: 'crl', desc: 'neither the signer\u2019s key nor the certificate is on the revocation list.' },
  { name: 'er-binding', desc: 'the certificate binds its evaluation report — the digest inside the signed payload.' },
  { name: 'timestamp', desc: 'the signing time is anchored — the key was valid when the signature was made.' },
  { name: 'transparency', desc: 'the certificate is in the public log — what was issued is what you hold.' },
]
---

<Base
  title="OIML CNML — Certificat Numérique de Métrologie Légale"
  description="OIML CNML, the Certificat Numérique de Métrologie Légale — the machine-readable certificate an issuing authority signs for a certified measuring-instrument type: anatomy of an issued certificate and the eight-check verification pipeline."
>
  <PageHero
    logo={{ name: "cnml-box", alt: "The OIML CNML logo." }}
    title="OIML CNML — the Certificat Numérique de Métrologie Légale"
    lede="The SMART certificate an issuing authority signs for a certified measuring-instrument type: a machine-readable XML document per Recommendation, carrying the certified type, the characteristics, and the test reports — verifiable by anyone, in a browser, in eight checks."
  />

  <div class="px-8 pb-20 max-w-5xl">
    {/* § 01 — anatomy of an issued certificate */}
    <section class="mb-16 bp-reveal">
      <div class="bp-section-anchor mb-4">
        <span class="bp-section-anchor__num">§ 01</span>
        <span>Anatomy of an issued certificate</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">one XML document per Recommendation</span>
      </div>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
        A CNML document is the end of the verdict chain: what the workflow established, the
        certificate carries — each part named, each part checkable.
      </p>
      <ol class="list-none p-0 m-0 flex flex-col border border-rule rounded-md overflow-hidden">
        {anatomy.map((a, i) => (
          <li class="flex gap-5 items-baseline bg-paper-soft p-5 border-b border-rule last:border-b-0 bp-card-hover">
            <span class="font-mono text-xs text-accent whitespace-nowrap">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-serif text-[1.0625rem] inline">{a.part}</h3>
              <span class="text-sm text-ink-soft"> — {a.desc}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* § 02 — the eight checks */}
    <section class="mb-16 bp-reveal">
      <div class="bp-section-anchor mb-4">
        <span class="bp-section-anchor__num">§ 02</span>
        <span>Verifying a certificate</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">the fixed eight-check pipeline</span>
      </div>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
        Verification is a fixed pipeline of eight checks — no keys, no accounts, no trust in the
        presenter. It runs in the browser; the file never leaves the verifier's device.
      </p>
      <div class="flex flex-col border border-rule rounded-md overflow-hidden">
        {checks.map((c, i) => (
          <div class="flex gap-5 items-baseline bg-paper-soft p-5 border-b border-rule last:border-b-0 bp-card-hover">
            <span class="font-mono text-xs text-ink-muted whitespace-nowrap">{String(i + 1).padStart(2, '0')}</span>
            <code class="font-mono text-[0.8125rem] text-accent whitespace-nowrap">{c.name}</code>
            <span class="text-sm text-ink-soft">{c.desc}</span>
          </div>
        ))}
      </div>
      <p class="text-sm text-ink-muted mt-4">
        Any check fails — stop. Do not accept the certificate; contact the issuing authority.
      </p>
    </section>

    {/* § 03 — where it fits */}
    <section class="mb-16 bp-reveal">
      <div class="bp-section-anchor mb-4">
        <span class="bp-section-anchor__num">§ 03</span>
        <span>Where it fits</span>
        <span class="bp-section-anchor__line"></span>
        <span class="bp-coord">the last step of the workflow</span>
      </div>
      <p class="text-[1.0625rem] leading-relaxed text-ink-soft max-w-3xl mb-6">
        CNML is how the OIML-CS SMART platform issues: evaluation completes, the authority signs,
        the certificate registers with the BIML. The format, the schemas, and the operator manuals
        live in the <code class="font-mono text-[0.875em]">oimlsmart/cnml</code> repository.
      </p>
      <p class="text-sm text-ink-muted max-w-3xl mb-6">
        CNML rides Primmel SMART certificates on Confium, the threshold-cryptography PKI — <a class="text-accent underline underline-offset-2" href="https://www.primmel.org/primmel-smart-docs/confium/" target="_blank" rel="noopener">the Confium volume</a>.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary bp-focus-ring" href="https://github.com/oimlsmart/cnml" target="_blank" rel="noopener">The CNML repository →</a>
        <a class="btn btn-ghost bp-focus-ring" href="/docs/cnml/">The CNML docs →</a>
        <a class="btn btn-ghost bp-focus-ring" href="/smart">The issuing workflow →</a>
        <a class="btn btn-ghost bp-focus-ring" href="/app/certificates">Certificates in the app →</a>
      </div>
    </section>
  </div>
</Base>
