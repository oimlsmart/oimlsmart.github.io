---
/**
 * The top site's base layout — the house shell from the package
 * (TODO.FULL/02: one chrome SSOT). The top site is the internal face:
 * the draft banner rides (`internal`), the brand/meta are the package
 * defaults.
 */
import Shell from '@oimlsmart/site-shell/components/Base.astro'
import SITE from '../data/site-meta'
import '../styles/app.css'

/** The AI assistant bubble (TODO.ai-platform/01) — the shared chrome's
 *  ONE component (site-shell#35, vendor/site-shell riding main), never
 *  a per-app copy. This const is the property's config flag: flip to
 *  false to retract the surface without touching the layout. The
 *  service origin defaults to https://ai.oimlsmart.org; anonymous
 *  visitors get the public corpus tier honestly marked, member sign-in
 *  rides the rag service's bubble bridge (rag#68). */
const aiAssistant = true

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
---

<Shell title={title} description={description} siteTitle={SITE.title} internal aiAssistant={aiAssistant}>
  <slot />
</Shell>
